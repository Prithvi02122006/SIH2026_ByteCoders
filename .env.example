# ──────────────────────────────────────────────────────────────────────────────
# FoodLoop — Environment Variables Reference
# Copy this file to .env and fill in the real values.
# NEVER commit the real .env file.
# ──────────────────────────────────────────────────────────────────────────────

# ── Frontend (used by Vite at build time — prefix VITE_ to expose to browser) ──
# In production on Vercel, set this to your Render backend URL (no trailing slash):
#   e.g. https://foodloop-backend.onrender.com
# Leave blank for local development (Vite proxies /api automatically).
VITE_API_URL=

# ── LLM Proxy (Server-Side Only — consumed by vite.config.ts dev proxy / api/llm.ts) ──
# Options: 'nugen', 'gemini', or 'grok'  (default: nugen)
LLM_PROVIDER=nugen

# Nugen Intelligence
NUGEN_API_KEY=
NUGEN_BASE_MODEL=qwen-v2p5-0p5b-instruct
# Generated by: npx tsx scripts/nugen-align.ts  (optional fine-tuned model)
NUGEN_ALIGNED_MODEL_ID=

# Optional fallback LLM keys
GEMINI_API_KEY=
XAI_API_KEY=

# ── Supabase (optional — not used by FoodLoop core, legacy from original scaffold) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# VERCEL DASHBOARD SETUP
# ──────────────────────────────────────────────────────────────────────────────
# Add these in: Vercel Project → Settings → Environment Variables
#
# Required for AI features to work on the live site:
#   LLM_PROVIDER             = nugen
#   NUGEN_API_KEY            = <your key>
#   NUGEN_ALIGNED_MODEL_ID   = <your aligned model id>  (optional)
#
# The FastAPI backend (backend/) cannot run on Vercel.
# Deploy it separately (e.g. Railway, Render, or a VPS) and
# set VITE_API_URL to point the frontend at that host:
#   VITE_API_URL=https://your-backend.railway.app
# ──────────────────────────────────────────────────────────────────────────────
