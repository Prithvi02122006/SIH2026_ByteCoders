# Supabase Configuration (Client-Facing)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# LLM Provider Configuration (Server-Side Only - never exposed to browser)
# Options: 'nugen', 'gemini', or 'grok' (default is 'nugen')
LLM_PROVIDER=nugen

# Nugen Intelligence Configuration
NUGEN_API_KEY=your_nugen_api_key_here
NUGEN_BASE_MODEL=qwen-v2p5-0p5b-instruct
# NUGEN_ALIGNED_MODEL_ID=your_aligned_model_id_here

# Optional Fallback LLM Keys
GEMINI_API_KEY=your_gemini_api_key_here
XAI_API_KEY=your_xai_api_key_here
