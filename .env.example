# Supabase Configuration (Client-Facing)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# LLM Provider Configuration (Server-Side Only - never exposed to browser)
# Options: 'nugen', 'gemini', or 'grok' (default is 'nugen')
LLM_PROVIDER=nugen

# Nugen Intelligence Configuration
NUGEN_API_KEY=your_nugen_api_key_here
NUGEN_BASE_MODEL=qwen-v2p5-0p5b-instruct
# NUGEN_ALIGNED_MODEL_ID is generated by running: npx tsx scripts/nugen-align.ts
# Set this after alignment completes — it activates the fine-tuned model for the live site.
# NUGEN_ALIGNED_MODEL_ID=your_aligned_model_id_here

# Optional Fallback LLM Keys
GEMINI_API_KEY=your_gemini_api_key_here
XAI_API_KEY=your_xai_api_key_here

# ──────────────────────────────────────────────────────────────────────────────
# PRODUCTION / VERCEL DEPLOYMENT NOTE
# ──────────────────────────────────────────────────────────────────────────────
# The variables above are used by the Vercel serverless function at api/llm.ts
# which powers every AI feature on the live site (/api/llm endpoint).
#
# Local .env files are NEVER uploaded to Vercel. You must set these variables
# manually in the Vercel dashboard:
#   Project → Settings → Environment Variables
#
# Required for Nugen AI to work in production:
#   NUGEN_API_KEY            — your Nugen Intelligence API key
#   NUGEN_ALIGNED_MODEL_ID   — (optional but recommended) aligned model ID
#   LLM_PROVIDER             — set to 'nugen' (or 'gemini' / 'grok')
#
# Without NUGEN_API_KEY set in Vercel, the live site will silently fall back
# to deterministic placeholder text for all AI-labeled features.
